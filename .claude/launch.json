{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "your-daily-guide-dev",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "exec bun run dev --port \"${PORT:-8080}\" --strictPort"],
      "port": 8080,
      "autoPort": true
    },
    {
      "name": "your-daily-guide-preview",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "PORT=4173 HOST=127.0.0.1 bun run preview"],
      "port": 4173
    },
    {
      "name": "mobile-metro",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd mobile && npx expo start --port 8081"],
      "port": 8081
    }
  ]
}
