# Supabase — panel del proyecto → Settings → API
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Las mismas, con prefijo VITE_ para que lleguen al bundle del cliente
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Web Push (VAPID) — generar con: bun x pushforge vapid
VAPID_PRIVATE_KEY=
VITE_VAPID_PUBLIC_KEY=

# URL pública de la app (para redirects de email, sin barra final)
VITE_PUBLIC_URL=http://localhost:8080

# Secreto compartido entre GitHub Actions y /api/cron/dispatch
CRON_SECRET=
