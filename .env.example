# Supabase — panel del proyecto → Settings → API
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Opcional: contraseña de la base de datos (panel → Database → Settings). Solo la
# usa la CLI para las migraciones (`supabase db push`, ver
# docs/agents/verification.md); la app no la lee.
# SUPABASE_DB_PASSWORD=

# Las mismas, con prefijo VITE_ para que lleguen al bundle del cliente
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Solo tests E2E: otra dirección para la API de OpenRouter (el mock de e2e/). La pone
# playwright.config.ts; no se define a mano y en producción se ignora.
# OPENROUTER_BASE_URL=

# Opcional: USDA FoodData Central — https://fdc.nal.usda.gov/api-key-signup
# Para los ingredientes que no están en la tabla de composición. Sin ella, se usa
# el alimento más parecido de la tabla.
# USDA_FDC_API_KEY=

# Validación del cuerpo de /api/chat (ticket 08). Vacía = modo informe: solo deja
# chat_body_rejected en el log. Con "1" rechaza de verdad.
# CHAT_BODY_ENFORCE=1

# Disyuntor global de gasto en IA (ticket 14), en dólares por día UTC y para TODAS
# las cuentas juntas. Vacía = apagado. Al llegar, la IA se pausa para todos hasta
# la medianoche UTC (429 "global", evento spend_global_tripped). Necesita la
# función SQL ai_spend_total_today (migración 20260930120000_ai_spend_total.sql).
# AI_GLOBAL_DAILY_USD=10

# Web Push (VAPID) — generar con: bun x pushforge vapid
VAPID_PRIVATE_KEY=
VITE_VAPID_PUBLIC_KEY=
# Opcional: contacto del remitente de los push (el `sub` de VAPID), con mailto:.
# VAPID_CONTACT=mailto:tu@correo.es

# URL pública de la app, SIN prefijo VITE_: la lee el servidor para los enlaces de los correos
# (confirmar cuenta, restablecer contraseña). Sin barra final. En producción:
# https://www.peppersfam.es (si falta allí, cae al dominio de Vercel y deja env_missing en el log).
PUBLIC_URL=http://localhost:8080

# Secreto compartido entre el cron (pg_cron, guardado en Supabase Vault como `cron_secret`; y el
# secret de GitHub para el disparo manual) y /api/cron/dispatch. 32 caracteres como mínimo
# (si no, se rechaza todo): `openssl rand -hex 32`.
CRON_SECRET=

# Sal del hash de los correos en las cuotas sin sesión (recuperar contraseña): sin ella, un
# SHA-256 del correo se revierte probando correos. `openssl rand -hex 32`. Si falta, se usa el
# hash sin sal y en producción queda env_missing en el log.
RATE_LIMIT_SALT=

# Resend — https://resend.com/api-keys
# Los correos de autenticación los manda nuestro backend por la API HTTP de
# Resend, no el SMTP de Supabase Auth (ver src/lib/email.server.ts).
RESEND_API_KEY=re_...
# Remitente. Sin dominio verificado en Resend hay que dejar el de pruebas, que
# SOLO entrega a la dirección con la que registraste la cuenta de Resend; para
# escribir a cualquier persona, verifica un dominio y ponlo aquí.
RESEND_FROM="Peppers <onboarding@resend.dev>"

# «Continuar con Google» solo aparece con "1", y solo debe ponerse cuando el
# proveedor Google esté activado en Supabase (Authentication → Providers).
# VITE_AUTH_GOOGLE=1

# CAPTCHA de Cloudflare Turnstile (ticket 29). Sin la clave de sitio no se carga
# nada. La clave de sitio es pública y el navegador la recibe en el build; la
# secreta comprueba en el servidor el alta y el restablecimiento (y va también
# en Supabase → Authentication → Attack Protection, que es quien comprueba el
# acceso y la demo). Con solo estas dos, una petición sin token se deja pasar y
# se anota; TURNSTILE_ENFORCE=1 la corta: ponerlo cuando todas las apps manden
# token.
# VITE_TURNSTILE_SITE_KEY=0x...
# TURNSTILE_SECRET_KEY=0x...
# TURNSTILE_ENFORCE=1

# Errores a Sentry (región UE, ticket 35). Sin ellas no se envía nada. El DSN es
# el del proyecto web en Sentry: el servidor lo lee en tiempo de ejecución y el
# navegador lo recibe en el build (VITE_), así que al cambiarlo hay que volver a
# desplegar. Solo errores: ni trazas de rendimiento ni grabación de sesiones.
# SENTRY_DSN=https://<clave>@o<org>.ingest.de.sentry.io/<proyecto>
# VITE_SENTRY_DSN=https://<clave>@o<org>.ingest.de.sentry.io/<proyecto>

# Inglés en la interfaz (ticket 34). Sin "1" solo se ofrece español; quien ya lo
# eligió lo conserva.
# VITE_I18N_EN=1

# Solo desarrollo: en qué interfaz escucha `bun run dev`. Por defecto 127.0.0.1;
# con "::" se abre a la red local, para probar desde un iPhone real.
# DEV_HOST=::
