# Mismos valores que el .env de la raíz (la app móvil usa el mismo proyecto de
# Supabase que la web). El prefijo EXPO_PUBLIC_ es obligatorio para que Expo los
# exponga al bundle; van al dispositivo, así que aquí SOLO la clave publishable,
# nunca la de servicio.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Dónde vive la API /api/v1/*. En desarrollo, la URL de tu `bun run dev` de la
# web: en el simulador de iOS localhost funciona, pero desde un iPhone real hay
# que poner la IP de tu Mac en la red local (p. ej. http://192.168.1.120:8080).
EXPO_PUBLIC_API_URL=http://localhost:8080
