{
  "expo": {
    "name": "Peppers",
    "slug": "daily-guide",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.victorgorina.dailyguide",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.security.application-groups": ["group.com.victorgorina.dailyguide"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FF8A3D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.RECORD_AUDIO"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "@bacons/apple-targets",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Peppers usa el micrófono para el dictado por voz.",
          "speechRecognitionPermission": "Peppers transcribe lo que dices para el dictado por voz."
        }
      ]
    ],
    "scheme": "dailyguide"
  }
}
