{
  "expo": {
    "name": "Peppers",
    "slug": "daily-guide",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F3F1ED"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.victorgorina.dailyguide",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSpeechRecognitionUsageDescription": "Peppers transcribe lo que dices para el dictado por voz.",
        "NSMicrophoneUsageDescription": "Peppers usa el micrófono para el dictado por voz."
      },
      "entitlements": {
        "com.apple.security.application-groups": ["group.com.victorgorina.dailyguide"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F3F1ED",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.RECORD_AUDIO"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "@bacons/apple-targets",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Peppers usa el micrófono para el dictado por voz.",
          "speechRecognitionPermission": "Peppers transcribe lo que dices para el dictado por voz."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Peppers usa tus fotos para leer el tiquet de la compra.",
          "cameraPermission": "Peppers usa la cámara para escanear el tiquet de la compra."
        }
      ],
      "expo-localization"
    ],
    "scheme": "dailyguide",
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.victorgorina.dailyguide.widget",
                  "targetName": "DailyGuideWidget",
                  "entitlements": {
                    "com.apple.security.application-groups": ["group.com.victorgorina.dailyguide"]
                  }
                }
              ]
            }
          }
        },
        "projectId": "f489050e-adb6-4c82-a685-d29a52f21dc8"
      }
    }
  }
}
